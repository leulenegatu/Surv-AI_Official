{
  "manifest_version": 3,
  "name": "Surv-AI Private Browser Companion",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "description": "Optional active-tab metadata for your paired local Surv-AI installation.",
  "key": "",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "incognito": "not_allowed",
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "Surv-AI Browser Companion"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:* ws://127.0.0.1:*"}
}
